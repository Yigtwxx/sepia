---
/* The social card, rendered as a page and captured into public/social-preview.jpg
   (the site's link preview) and .github/social-preview.jpg (GitHub's), see
   scripts/og.md. 1280x640, GitHub's recommended size. Not linked, not indexed,
   not in the sitemap. */
import '../styles/global.css';
import PencilDefs from '../components/sketch/PencilDefs.astro';
import Inkprint from '../components/Inkprint.astro';
import SketchUnderline from '../components/sketch/SketchUnderline.astro';
import Logo from '../components/Logo.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex, nofollow" />
        <title>social</title>
    </head>
    <body>
        <PencilDefs />
        <div class="card">
            <div class="plate">
                <Inkprint id="verany-side" reveal={false} ripples={false} />
            </div>
            <div class="wash"></div>
            <div class="copy">
                <p class="kicker">
                    <Logo size="58px" tone="paper" /> sepia
                </p>
                <h1 class="title">
                    Describe it.
                    <br />
                    Watch it <SketchUnderline>ink.</SketchUnderline>
                </h1>
                <p class="marginalia note">Every character picked for the picture under it.</p>
                <p class="foot">text to picture · uv tool install sepia-cli</p>
            </div>
        </div>
    </body>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        width: 1280px;
        height: 640px;
        overflow: hidden;
    }
    body::before,
    body::after {
        display: none;
    }
    /* Vérany's cuttlefish swims in from the right in characters; the words sit
       on the paper it fades into. */
    .card {
        position: relative;
        width: 1280px;
        height: 640px;
        overflow: hidden;
        /* a deeper sheet than the page's, pink running into lilac */
        --card: #e6c1df;
        background:
            radial-gradient(ellipse 60% 70% at 78% 50%, rgb(240 160 214 / 0.55), transparent 70%),
            linear-gradient(120deg, var(--card), #dbc0ec);
        color: var(--ink);
    }
    .plate {
        position: absolute;
        top: 50%;
        right: 36px;
        width: 800px;
        transform: translateY(-50%);
    }
    .wash {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to right,
            var(--card) 0%,
            var(--card) 34%,
            color-mix(in srgb, var(--card) 65%, transparent) 46%,
            transparent 58%
        );
    }
    .copy {
        position: relative;
        box-sizing: border-box;
        height: 100%;
        max-width: 760px;
        padding: 64px 72px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .kicker {
        display: flex;
        align-items: center;
        gap: 16px;
        font-family: var(--font-mono);
        font-size: 26px;
        color: var(--pen);
        margin: 0 0 22px;
    }
    .title {
        font-size: 92px;
        font-weight: 380;
        line-height: 0.98;
        letter-spacing: -0.02em;
        color: var(--ink);
        margin: 0 0 30px;
        font-variation-settings:
            'opsz' 144,
            'SOFT' 60,
            'WONK' 1;
    }
    .note {
        font-size: 32px;
        line-height: 1.25;
        max-width: 22ch;
        margin: 0 0 26px;
    }
    .foot {
        font-family: var(--font-mono);
        font-size: 19px;
        color: var(--ink-mute);
        margin: 0;
    }
</style>
