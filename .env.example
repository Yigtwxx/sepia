# Copy to .env (development) or let `sepia` ask for the key on first run.
ANTHROPIC_API_KEY=

# Optional, from https://enter.pollinations.ai: removes the logo, better models.
# Pictures cost pollen (about $0.005 each); new accounts get a one-time bonus.
# Without it sepia uses the local GPU model and the keyless endpoint.
POLLINATIONS_KEY=

# Optional, from https://brave.com/search/api (monthly free credits, about
# 1,000 searches): a named subject ("yunara lol") comes from the top
# pictures of an image search. Without it sepia uses wiki pages.
BRAVE_SEARCH_API_KEY=

# Optional overrides
# SEPIA_MODEL=claude-haiku-5-5        (or claude-sonnet-5-5)
# SEPIA_EFFORT=high                  (low, medium, high, xhigh or max)
# SEPIA_STYLE=ink                     (or fill)
# SEPIA_CHARSET=classic               (or symbols)
# SEPIA_MATURE=off                    (or on: sexy and dark pictures, never explicit)
# SEPIA_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
