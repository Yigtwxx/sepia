# Copy to .env (development) or let `sepia` ask for the key on first run.
ANTHROPIC_API_KEY=

# Optional, for painting on Cloudflare Workers AI (FLUX.2 [klein] 4B). Free
# account, no credit card: https://dash.cloudflare.com/?to=/:account/ai/workers-ai
# -> Use REST API -> Create a Workers AI API Token. The Account ID is on the
# same page. Free tier: 10,000 neurons a day (about 100 pictures), reset at
# 00:00 UTC. Set both or neither; without them sepia paints only with the
# local GPU model.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional, from https://brave.com/search/api (monthly free credits, about
# 1,000 searches): a named subject ("yunara lol") comes from the top
# pictures of an image search. Without it sepia uses wiki pages.
BRAVE_SEARCH_API_KEY=

# Optional overrides
# SEPIA_MODEL=claude-haiku-5-5        (or claude-sonnet-5-5, claude-opus-5-5, claude-fable-5-1)
# SEPIA_EFFORT=high                  (low, medium, high, xhigh or max)
# SEPIA_STYLE=ink                     (or fill)
# SEPIA_CHARSET=classic               (or symbols)
# SEPIA_MATURE=off                    (or on: sexy and dark pictures, never explicit)
# SEPIA_ASK=on                         (or off: no clarifying questions)
# SEPIA_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
